# Copia este archivo a .env y completa los valores.
# Vite solo expone al cliente las variables con prefijo VITE_.

# --- Backend (ejemplo con Supabase) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Config general ---
# URL pública de la app (para el QR de trazabilidad, deep links, etc.)
VITE_APP_URL=http://localhost:5173

# Fuente del precio de referencia del café (si se integra una API real).
# Si queda vacío se usa el mock en src/app/producer/data/preciosReferencia.ts
VITE_PRECIO_CAFE_API=
